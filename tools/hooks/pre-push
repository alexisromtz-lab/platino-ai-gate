#!/usr/bin/env bash
# Gate de atribución: todo commit posterior a la época declara su modelo.
#
# NO usar `cmd | while ...; do exit 1; done`: el exit mata el subshell y el RC
# se pierde (el gate deja de bloquear en cuanto se añade un echo al final).
# bad=0 acumula, exit $bad al final. Tampoco `grep -c` (RC 1 con 0 matches
# aborta bajo set -e); los recuentos van con awk.
#
# Invariante: toda línea ^Model: del mensaje es trailer del bloque final y todo
# trailer Model: tiene valor en tools/hooks/models.txt. Con más de un Model:
# se exige exactamente un Squash-Reason: no vacío.
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel) || exit 1
MODELS_FILE="$ROOT/tools/hooks/models.txt"
[ -f "$MODELS_FILE" ] || { echo "models.txt ausente: $MODELS_FILE" >&2; exit 1; }

# Exención declarada: una línea por SHA, formato <sha> TAB <razón>.
# Ausencia del archivo = sin exenciones (el gate queda estricto, nunca más laxo).
# Una línea sin razón, o con el SHA en otro campo, no se honra: una exención no
# puede entrar sin motivo escrito ni por parecido de prefijo.
EXEMPT_FILE="$ROOT/tools/hooks/epoch-exempt.txt"
es_bot_email() {
  local email
  email=$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')
  case "$email" in
    *'[bot]'*|*automation*|github-actions@github.com) return 0 ;;
    *) return 1 ;;
  esac
}

exento() {
  [ -f "$EXEMPT_FILE" ] || return 1
  awk -F'\t' -v h="$1" '
    /^[[:space:]]*#/ { next }
    NF < 2 || $2 !~ /[^[:space:]]/ { next }
    $1 == h { found = 1 }
    END { exit(found ? 0 : 1) }
  ' "$EXEMPT_FILE"
}

EPOCH=$(git rev-parse -q --verify 'refs/tags/hooks-epoch^{commit}') ||
  { echo "hooks-epoch ausente: git fetch --tags" >&2; exit 1; }

VALORES=$(mktemp "${TMPDIR:-/tmp}/models_vals.XXXXXX") || exit 1
trap 'rm -f "$VALORES"' EXIT

bad=0
scanned=0
exempted=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "${local_sha:-}" in ''|0000000000000000000000000000000000000000) continue ;; esac
  # HUELLA-PREPUSH-MAIN-COMMIT-BRANCH-20261022
  # Un commit del mecanismo debe ser alcanzable desde main antes de publicar.
  for h in $(git rev-list "$EPOCH..$local_sha"); do
    exento "$h" && continue
    if git diff-tree --root --no-commit-id --name-only -r -m "$h" |
      grep -qE '^(AGENTS\.md|SUCIOS\.md|certificados/|docs/)'; then
      if ! git branch --contains "$h" --format='%(refname:short)' | grep -qxF main; then
        echo "RECHAZO fuera_de_main (commit de mecanismo): $h" >&2
        bad=1
      fi
    fi
  done
  for h in $(git rev-list --no-merges "$EPOCH..$local_sha"); do
    if exento "$h"; then
      exempted=$((exempted + 1))
      continue
    fi
    scanned=$((scanned + 1))
    body=$(git log -1 --format=%B "$h")
    tr=$(printf '%s\n' "$body" | git interpret-trailers --parse)

    n_all=$(printf '%s\n' "$body" | awk '/^Model:/{c++} END{print c+0}')
    n_tr=$(printf '%s\n' "$tr" | awk -F': ' '/^Model:/ && $2 ~ /[^[:space:]]/ {c++} END{print c+0}')
    n_tr_empty=$(printf '%s\n' "$tr" | awk -F': ' '/^Model:/ && $2 !~ /[^[:space:]]/ {c++} END{print c+0}')
    n_sq=$(printf '%s\n' "$tr" | awk -F': ' '/^Squash-Reason:/ && $2 ~ /[^[:space:]]/ {c++} END{print c+0}')
    n_sq_empty=$(printf '%s\n' "$tr" | awk -F': ' '/^Squash-Reason:/ && $2 !~ /[^[:space:]]/ {c++} END{print c+0}')

    if [ "$n_all" -eq 0 ]; then
      echo "RECHAZO sin Model: $h" >&2; bad=1; continue
    fi
    if [ "$n_all" -ne $((n_tr + n_tr_empty)) ]; then
      echo "RECHAZO Model: en prosa (lineas=$n_all trailers=$((n_tr + n_tr_empty))): $h" >&2
      bad=1; continue
    fi
    if [ "$n_tr_empty" -gt 0 ]; then
      echo "RECHAZO Model: vacio: $h" >&2; bad=1; continue
    fi
    if [ "$n_tr" -gt 1 ] && { [ "$n_sq" -ne 1 ] || [ "$n_sq_empty" -ne 0 ]; }; then
      echo "RECHAZO squash sin Squash-Reason unico no vacio (ok=$n_sq vacios=$n_sq_empty modelos=$n_tr): $h" >&2
      bad=1; continue
    fi

    printf '%s\n' "$tr" | awk -F': ' '/^Model:/ {print $2}' > "$VALORES"
    while IFS= read -r m; do
      if [ "$m" = none ]; then
        subject=$(git log -1 --format=%s "$h")
        author_email=$(git log -1 --format=%ae "$h")
        if [[ "$subject" != Revert\ * ]] && ! es_bot_email "$author_email"; then
          echo "RECHAZO Model: none no es válido para un commit con código. Declara tu modelo real: $h" >&2
          bad=1
        fi
      else
        grep -qxF -- "$m" "$MODELS_FILE" ||
          { echo "RECHAZO Model '$m' no en models.txt: $h" >&2; bad=1; }
      fi
    done < "$VALORES"
  done
done

echo "EPOCH: $(git rev-parse --short "$EPOCH") . SCANNED: $scanned . EXENTOS: $exempted"
exit $bad
