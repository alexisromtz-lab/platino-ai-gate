#!/usr/bin/env bash
# Attribution gate: every commit after the epoch declares its model.
#
# HUELLA-PREPUSH-EN-20261023
# HUELLA-PREPUSH-PATH-20261023
#
# Do NOT use `cmd | while ...; do exit 1; done`: the exit kills the subshell and
# the exit code is lost (the gate stops blocking the moment an echo is added
# after the loop). bad=0 accumulates, exit $bad at the end. Nor `grep -c` (RC 1
# with zero matches aborts under set -e); every count runs awk.
#
# Invariant: every ^Model: line of the message is a trailer of the final block,
# and every Model: trailer has a value listed in tools/hooks/models.txt. With
# more than one Model: exactly one non-empty Squash-Reason: is required.
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel) || exit 1
MODELS_FILE="$ROOT/tools/hooks/models.txt"
[ -f "$MODELS_FILE" ] || { echo "models.txt missing: ${MODELS_FILE#"$ROOT"/}" >&2; exit 1; }

# Declared exemption: one line per SHA, format <sha> TAB <reason>.
# No file at all = no exemptions (the gate stays strict, never laxer).
# A line without a reason, or with the SHA in another field, is not honoured: an
# exemption cannot enter without a written reason, nor by prefix similarity.
EXEMPT_FILE="$ROOT/tools/hooks/epoch-exempt.txt"
is_bot_email() {
  local email
  email=$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')
  case "$email" in
    *'[bot]'*|*automation*|github-actions@github.com) return 0 ;;
    *) return 1 ;;
  esac
}

exempt() {
  [ -f "$EXEMPT_FILE" ] || return 1
  awk -F'\t' -v h="$1" '
    /^[[:space:]]*#/ { next }
    NF < 2 || $2 !~ /[^[:space:]]/ { next }
    $1 == h { found = 1 }
    END { exit(found ? 0 : 1) }
  ' "$EXEMPT_FILE"
}

EPOCH=$(git rev-parse -q --verify 'refs/tags/hooks-epoch^{commit}') ||
  { echo "hooks-epoch tag missing (run: git fetch --tags)" >&2; exit 1; }

VALUES=$(mktemp "${TMPDIR:-/tmp}/models_vals.XXXXXX") || exit 1
trap 'rm -f "$VALUES"' EXIT

bad=0
scanned=0
exempted=0

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "${local_sha:-}" in ''|0000000000000000000000000000000000000000) continue ;; esac
  # HUELLA-PREPUSH-MAIN-COMMIT-BRANCH-20261022
  # A mechanism commit must be reachable from main before it is published.
  for h in $(git rev-list "$EPOCH..$local_sha"); do
    exempt "$h" && continue
    if git diff-tree --root --no-commit-id --name-only -r -m "$h" |
      grep -qE '^(AGENTS\.md|SUCIOS\.md|certificados/|docs/)'; then
      if ! git branch --contains "$h" --format='%(refname:short)' | grep -qxF main; then
        echo "REJECTED outside_main (mechanism commit): $h" >&2
        bad=1
      fi
    fi
  done
  for h in $(git rev-list --no-merges "$EPOCH..$local_sha"); do
    if exempt "$h"; then
      exempted=$((exempted + 1))
      continue
    fi
    scanned=$((scanned + 1))
    body=$(git log -1 --format=%B "$h")
    tr=$(printf '%s\n' "$body" | git interpret-trailers --parse)

    n_all=$(printf '%s\n' "$body" | awk '/^Model:/{c++} END{print c+0}')
    n_tr=$(printf '%s\n' "$tr" | awk -F': ' '/^Model:/ && $2 ~ /[^[:space:]]/ {c++} END{print c+0}')
    n_tr_empty=$(printf '%s\n' "$tr" | awk -F': ' '/^Model:/ && $2 !~ /[^[:space:]]/ {c++} END{print c+0}')
    n_sq=$(printf '%s\n' "$tr" | awk -F': ' '/^Squash-Reason:/ && $2 ~ /[^[:space:]]/ {c++} END{print c+0}')
    n_sq_empty=$(printf '%s\n' "$tr" | awk -F': ' '/^Squash-Reason:/ && $2 !~ /[^[:space:]]/ {c++} END{print c+0}')

    if [ "$n_all" -eq 0 ]; then
      echo "REJECTED missing Model: $h" >&2; bad=1; continue
    fi
    if [ "$n_all" -ne $((n_tr + n_tr_empty)) ]; then
      echo "REJECTED Model: is in the body (prose) (lines=$n_all trailers=$((n_tr + n_tr_empty))): $h" >&2
      bad=1; continue
    fi
    if [ "$n_tr_empty" -gt 0 ]; then
      echo "REJECTED Model: is empty: $h" >&2; bad=1; continue
    fi
    if [ "$n_tr" -gt 1 ] && { [ "$n_sq" -ne 1 ] || [ "$n_sq_empty" -ne 0 ]; }; then
      echo "REJECTED squash without exactly one non-empty Squash-Reason: (ok=$n_sq empty=$n_sq_empty models=$n_tr): $h" >&2
      bad=1; continue
    fi

    printf '%s\n' "$tr" | awk -F': ' '/^Model:/ {print $2}' > "$VALUES"
    while IFS= read -r m; do
      if [ "$m" = none ]; then
        subject=$(git log -1 --format=%s "$h")
        author_email=$(git log -1 --format=%ae "$h")
        if [[ "$subject" != Revert\ * ]] && ! is_bot_email "$author_email"; then
          echo "REJECTED Model: none is not valid for a commit with code. Declare the model that actually wrote it: $h" >&2
          bad=1
        fi
      else
        grep -qxF -- "$m" "$MODELS_FILE" ||
          { echo "REJECTED Model '$m' is not in models.txt: $h" >&2; bad=1; }
      fi
    done < "$VALUES"
  done
done

echo "EPOCH: $(git rev-parse --short "$EPOCH") . SCANNED: $scanned . EXEMPTED: $exempted"
exit $bad
